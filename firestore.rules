rules_version = '2';

// ==========================================
// 🔒 قواعد أمان Firestore — منصة مسار
// ==========================================
// ⚠️ **هذه هي الحماية الحقيقية، لا كود التطبيق.** أي شخص يستطيع نداء
//    Firestore بتوكنه مباشرةً دون المرور بتطبيقنا.
//
// ⚠️⚠️ الفخ الأخطر ([07§2]): في rules_version 2 النمط `{doc=**}` يطابق
//    **صفر مقاطع أو أكثر** — أي أن `match /users/{uid}/{doc=**}` يطابق
//    مستند `/users/{uid}` نفسه. والقواعد تعمل بـ OR (أي قاعدة تسمح ⇒ يمر).
//    فلو استعملناه لسمح للطالب بكتابة `role: "admin"` في مستنده.
//    ولذلك: **مستند المستخدم له قاعدته، وفروعه لها قاعدة منفصلة `/{col}/{docId}`.**
//
// النشر:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // ═════════ مساعدات ═════════
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /// 👤 **الزائرُ لا مستندَ له** — حسابُه مجهولٌ للتجربة لا للتسجيل.
    ///
    /// ☢️ أُضيف ٢٠٢٦-٠٩-٢٣ بعد ثغرةٍ في التطبيق: «Cancel» في نافذة جوجل
    ///    كان يُمضي الزائرَ في مسار النجاح فيُنشئ له مستندَ طالبٍ كامل
    ///    (`_ensureProfile`). أُصلح في التطبيق، وهذا **الجدارُ الثاني**:
    ///    من لا يمرّ بتطبيقنا أصلاً لا يصنع لحسابٍ مجهولٍ ملفاً أيضاً.
    ///    والتطبيقُ لا يكتب مستنداً لزائرٍ أبداً ([UserSession._ensureProfile]).
    function notAnonymous() {
      return request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    /// الحقول التي لا يجوز للطالب لمسها في مستنده إطلاقاً.
    ///
    /// 📲 `fcm_tokens` منها منذ وصلت الإشعارات: رمز الجهاز يكتبه **الخادم**
    ///    عبر `/me/device` لا العميل. سببان — `arrayUnion` من العميل لا
    ///    يمكن تحديدها بسقف فيُثقَل المستند بآلاف الرموز، ورمزُ الجهاز
    ///    مفتاحُ وصولٍ إلى جيب الطالب فلا يُترك لعميلٍ يُعدَّل.
    ///
    /// 🔴 **و`banned` و`quota_override` أُضيفا بعد ثغرةٍ حقيقية:** الخادم
    ///    يقرأ الحقلين من **هذا المستند بعينه** — `banned` في
    ///    `core/user_state.py` (بوابة الحظر في `_authenticate`)، و
    ///    `quota_override` في `core/quota.py` (سقف الأسئلة اليومي). وكانت
    ///    قاعدة التحديث تسمح لصاحب الحساب بالكتابة فيهما، فيكفي الطالبَ
    ///    نداءٌ واحد من SDK مباشرةً:
    ///
    ///        updateDoc(doc(db,'users',myUid),
    ///                  {banned:false, quota_override:999999,
    ///                   name:'x', grade:3, track:'علمي'})
    ///
    ///    ليفكّ حظره ويمنح نفسه أسئلةً بلا حدّ. أي أن **نظامَي الحظر
    ///    والحصص كانا معطَّلين فعلياً** — والحصة هي البوابة الوحيدة على
    ///    فاتورة الموديلات بعد حذف أكواد التفعيل.
    ///
    /// ⚠️ ولا يكفي أن يمنعها الخادم: من يملك توكناً يكتب في Firestore
    ///    **دون المرور بنا أصلاً**. القاعدة هنا هي الحماية الوحيدة.
    function keepsProtectedFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['created_at', 'fcm_tokens', 'banned', 'quota_override']);
    }

    /// الحقول الإدارية غائبةٌ تماماً عن مستندٍ **جديد**.
    ///
    /// ⚠️ حراسة التحديث وحدها لا تكفي: من أنشأ مستنده أول مرة وفيه
    ///    `quota_override: 999999` لم «يُعدّل» شيئاً — و`keepsProtectedFields`
    ///    تقارن بـ`resource.data` التي **لا وجود لها عند الإنشاء**.
    function noAdminFieldsOnCreate() {
      return !request.resource.data.keys().hasAny(['banned', 'quota_override']);
    }

    /// 🎭 الدور الذي يجوز لصاحب الحساب أن يكتبه — **قائمة مغلقة**.
    ///
    /// `student` و`teacher` شكلا واجهةٍ يختارهما صاحب الحساب من الإعدادات،
    /// أما `admin` فامتيازٌ يفتح مستندات كل الطلاب ([07§2]) — فلا يُكتب من
    /// عميلٍ أبداً، بل من الكونسول أو خادمٍ بـAdmin SDK.
    ///
    /// ⚠️ وهي تُطبَّق على **الإنشاء والتحديث معاً**: لو حرسنا الإنشاء وحده
    ///    لأنشأ المهاجم مستنده طالباً ثم حدّثه أدمن في النداء التالي.
    function validRole() {
      return !('role' in request.resource.data)
        || request.resource.data.role in ['student', 'teacher'];
    }

    /// دور المستخدم **لم يتغيّر** في هذا التحديث؟
    function roleUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
    }

    /// تحقّق من شكل مستند المحادثة — يمنع بيانات مشوّهة أو حقولاً غريبة.
    /// (الحجم نفسه يحرسه Firestore بحدّ 1 MiB، وسقف 200 KB يُطبَّق في التطبيق.)
    function validConversation() {
      let d = request.resource.data;
      return d.messages is list
        && d.messages.size() <= 400
        && d.subject is string && d.subject.size() <= 64
        && d.mode is string && d.mode.size() <= 32
        && d.title is string && d.title.size() <= 120
        && d.grade is int && d.grade >= 1 && d.grade <= 3
        && d.track in ['عام', 'علمي', 'أدبي']
        && d.scope_key is string && d.scope_key.size() <= 200
        // 📄 صفحاتُ المحادثة (٢٠٢٦-٠٩-٢٤) — اختياريةٌ لمستنداتِ ما قبلها،
        //    وسقفُها **٣** = `MAX_PAGES_EXPLAIN_SUMMARY` في الخادم وحدُّ المُنتقي
        //    في التطبيق (`ChatConversation.maxPages`). رفعُ أحدها وحده يُفشل
        //    المزامنةَ صامتةً.
        && (!('pages' in d) || (d.pages is list && d.pages.size() <= 3));
    }

    /// شكل محادثة المنحة — نفس سقوف محادثة التعليم كي لا تنتفخ القاعدة.
    /// ⚠️ يجب أن يطابق `maxCloudMessages` في `conversation_sync.dart`؛
    ///    رفعُ أحدهما دون الآخر يُفشل المزامنة **صامتةً**.
    function validScholarshipChat() {
      let d = request.resource.data;
      return d.messages is list
        && d.messages.size() <= 400
        && d.scholarship_id is string && d.scholarship_id.size() <= 64
        && d.title is string && d.title.size() <= 120;
    }

    function validProfile() {
      return request.resource.data.grade is int
        && request.resource.data.grade >= 1
        && request.resource.data.grade <= 3
        && request.resource.data.track in ['عام', 'علمي', 'أدبي']
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60;
    }

    // ═════════ مستند المستخدم ═════════
    // ★ لا `{doc=**}` هنا — راجع التحذير أعلاه.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // الإنشاء: الدور من القائمة المغلقة (أو غائباً ⇒ طالب)، ولا حقول
      // إدارية إطلاقاً — راجع `noAdminFieldsOnCreate` أعلاه.
      allow create: if isOwner(uid) && notAnonymous() && validProfile()
        && validRole() && noAdminFieldsOnCreate();

      // التحديث: تاريخ الإنشاء ورموز الأجهزة محميّة دائماً، والدور يُبدَّل
      // بين طالبٍ ومعلّم فقط — ومن كان `admin` يبقى كما هو ولا يُنزَع منه
      // ولا يُمنح لأحد، لأن `roleUnchanged` هي البديل الوحيد لـ`validRole`.
      allow update: if isOwner(uid)
        && validProfile()
        && keepsProtectedFields()
        && (roleUnchanged() || validRole());

      allow delete: if isOwner(uid);   // «حذف حسابي» (إلزام Google Play)

      // ── فروع المستخدم: محادثاته ونتائجه ومحفوظاته ──
      // ⚠️ نمط `/{col}/{docId}` مقصود: لا يطابق مستند المستخدم الأب.
      match /conversations/{convId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validConversation();
      }
      // 🎓 محادثات مساعد المنح — مربوطة بالحساب وتعود معه على جهاز جديد ([32§5]).
      match /scholarship_chats/{chatId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validScholarshipChat();
      }
      match /{col}/{docId} {
        allow read, write: if isOwner(uid) && col in ['results', 'saved_answers'];
      }
    }

    // ═════════ الإعدادات العامة ═════════
    // يقرأها كل مستخدم (حتى الزائر) — وهي أساس كاش النسخة (meta.version).
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ═════════ محتوى تقرأه الواجهة ويحرّره الأدمن ═════════
    match /scholarships/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /services/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /banners/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /suggested_questions/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ═════════ 🔒 أسرار لا يلمسها العميل إطلاقاً ═════════
    // الباك اند يقرأها بـ Admin SDK الذي **يتجاوز هذه القواعد كلياً**،
    // فلا سبب لفتحها للطلاب — ولا حتى للقراءة.
    match /prompts/{docId} {
      allow read, write: if false;
    }
    match /scholarship_prompts/{docId} {
      allow read, write: if false;
    }

    // ═════════ 🎟️ عدّادات الحصة ═════════
    // يكتبها الباك اند وحده (Admin SDK). الطالب يقرأ عدّاده ليرى المتبقي،
    // ولا يكتبه أبداً — وإلا صفّر حصته بنفسه.
    match /usage/{docId} {
      allow read: if signedIn() && docId.matches('.*' + request.auth.uid + '.*');
      allow write: if false;
    }

    // ═════════ 📊 الإحصائيات ═════════
    match /stats/{docId} {
      allow read: if isAdmin();
      allow write: if false;      // الباك اند فقط
    }

    // ═════════ الافتراضي: الرفض ═════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
